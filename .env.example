# Copy to .env and fill in. Never paste these into chat or commit them.
# 0G: sk- key from pc.0g.ai
ZG_SK=
# Hedera testnet, ECDSA accounts from portal.hedera.com
BUYER_ACCOUNT_ID=
BUYER_PRIVATE_KEY=
STUDY_ACCOUNT_ID=
STUDY_PRIVATE_KEY=
# World, from the portal (sandbox unless World says otherwise)
WORLD_ISSUER=https://sandbox.auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# Public HTTPS base URL, for example your ngrok domain
PUBLIC_BASE_URL=
POOL_KEK=  # 32 random bytes, base64: openssl rand -base64 32
PGLITE_DIR=./data/pool
# Created by scripts/setup-payouts.ts: the agent's HCS spend log and the labelled demo treasury for seed shares
HCS_TOPIC_ID=
DEMO_TREASURY_ID=
DEMO_TREASURY_KEY=
# Smallest claim in micro-USDC (default 10000 = $0.01)
MIN_CLAIM_MICRO=
# Sign-in: dev (labelled stand-in, proves nothing) until World access works, then world
IDENTITY=dev
# Where sign-in sends people back to (the web app); defaults to the API's own base URL
APP_URL=
# How long a passed check counts as fresh for widening sharing or claiming, in seconds
FRESH_WINDOW_S=600
# Auto-collect: sync anyone with auto-collect on who has not synced in this many hours (checked hourly)
SYNC_EVERY_HOURS=6
# Sealed AI for pattern queries and the daily brief: 0g, or off (features report unavailable; no unsealed fallback)
SEALED=0g
# Sealed reads run in parallel per query
READ_CONCURRENCY=8
